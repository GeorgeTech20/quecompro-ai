# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnpm-store/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# entorno local — todo .env queda fuera salvo la plantilla, que sí se comparte
.env
.env*.local
!.env.example

# volcados de depuración: suelen acabar con claves dentro
.tmp_*
# scripts/portal-extract-token.mjs escribe aquí JWT de sesión
tmp_tokens/

# supabase
supabase/.temp

# agente de precios
.agent-browser/

# clerk configuration (can include secrets)
/.clerk/

.vercel

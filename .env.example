# ---------------------------------------------------------------------------
# QueCompro.ai — variables de entorno
# Copia este archivo a .env.local y rellena los valores. .env.local NO se commitea.
# ---------------------------------------------------------------------------

# URL pública de producción. Se usa en canonical, Open Graph, robots y sitemap.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- Clerk (auth) ---------------------------------------------------------
# Publishable key: viaja al bundle del navegador (es pública por diseño).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Secret: SOLO servidor.
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/welcome

# --- Supabase (data store) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# Service role: SOLO servidor. Salta RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# --- Portal (realtime) -----------------------------------------------------
# Pega los valores SIN comillas: `NEXT_PUBLIC_*` se inlinea tal cual en el
# bundle, y una comilla de más hace que Portal devuelva invalid_api_key.
#
# Publishable key: identifica el environment en el socket. Pública por diseño.
NEXT_PUBLIC_PORTAL_PUBLISHABLE_KEY=pk_xxx
# Secret key: SOLO servidor. Acuña los tokens de usuario en POST /v1/tokens.
# No sirve para firmar un JWT a mano — Portal verifica con la clave del
# environment, que nunca sale de Portal.
PORTAL_SECRET_KEY=sk_xxx
# Opcional. Si está, /api/portal-token verifica que el token acuñado sea de
# este environment; sirve para cazar una secret key de otro proyecto.
PORTAL_ENV_ID=env_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (asistente) ----------------------------------------------------
# SOLO servidor. Nunca se expone al cliente.
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Proveedor recomendado para el asistente de compras. Si existe, tiene
# prioridad sobre OPENAI_API_KEY.
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Agente de precios -----------------------------------------------------
# DEMO_MODE=1 usa el dataset local en vez de salir a scrapear tiendas.
DEMO_MODE=1
